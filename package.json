{
  "name": "nav-ai-root",
  "version": "1.0.0",
  "description": "Nav AI Full-Stack Nutrition & Fitness Platform",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "npm --prefix client run build && node -e \"import fs from 'fs'; fs.cpSync('client/dist', 'dist', { recursive: true });\"",
    "client:dev": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build",
    "server:dev": "npm --prefix server run dev",
    "server:start": "npm --prefix server start",
    "server:test": "npm --prefix server run test"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "@supabase/supabase-js": "^2.49.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1",
    "zod": "^3.24.2"
  },
  "workspaces": [
    "client",
    "server"
  ]
}